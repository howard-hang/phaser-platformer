{
  "name": "phaser-platformer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "subset-font": "node scripts/subset-font.mjs",
    "build": "node scripts/subset-font.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "android:sync": "cap sync android",
    "android:apk": "npm run build && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "puppeteer-core": "^25.12.0",
    "subset-font": "2.9.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
